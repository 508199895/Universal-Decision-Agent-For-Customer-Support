# Qdrant database used by the bundled MCP server
QDRANT_URL=http://127.0.0.1:6333
# QDRANT_API_KEY=
COLLECTION_NAME=uda-hub-retrieval-eval

# Keep these aligned with the existing collection's vector schema
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
SPARSE_EMBEDDING_MODEL=Qdrant/bm25
QDRANT_SEARCH_LIMIT=3

RERANKER_MODEL=BAAI/bge-reranker-base

# Optional LangSmith ticket traces (disabled when tracing is unset or no key is present).
# Traces redact credentials and omit Markdown file references and content.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=customer-support
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
