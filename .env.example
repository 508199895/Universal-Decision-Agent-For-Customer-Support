# Qdrant database used by the bundled MCP server
QDRANT_URL=http://127.0.0.1:6333
# QDRANT_API_KEY=
COLLECTION_NAME=uda-hub-retrieval-eval

# Keep these aligned with the existing collection's vector schema
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
SPARSE_EMBEDDING_MODEL=Qdrant/bm25
QDRANT_SEARCH_LIMIT=3

RERANKER_MODEL=BAAI/bge-reranker-base

# Customer-support workflow model
DEEPSEEK_API_KEY=
# Optional path override for the core user database
# UDAHUB_DB_PATH=data/core/udahub.db

# Feishu bot used by `uvicorn agentic.app.fastapi_server:app --reload`
LARK_APP_ID=
LARK_APP_SECRET=
FEISHU_CHAT_ID=

# Optional LangSmith ticket traces (disabled when tracing is unset or no key is present).
# Traces redact common secret formats with LangSmith's SDK anonymizer.
# LangSmith project name is the repository root directory name.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
