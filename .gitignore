# ---------------------------------------------------------
# Python bytecode / cache
# ---------------------------------------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Compiled Python files
*.so

# ---------------------------------------------------------
# Jupyter Notebook
# ---------------------------------------------------------
.ipynb_checkpoints/
*/.ipynb_checkpoints/
*.ipynb_checkpoints

# ---------------------------------------------------------
# VSCode / IDE
# ---------------------------------------------------------
.vscode/
.idea/

# ---------------------------------------------------------
# macOS system files
# ---------------------------------------------------------
.DS_Store

# ---------------------------------------------------------
# Environment / virtual envs
# ---------------------------------------------------------
.env
*.env
venv/
env/
.venv/

# ---------------------------------------------------------
# pytest cache
# ---------------------------------------------------------
.pytest_cache/
*/.pytest_cache/

# Local FastEmbed model weights (large, machine-specific cache)
/mcp_services/qdrant/.cache/

# Common local cache and temporary directories
**/.cache/
**/tmp/
**/temp/

# Pytest/evaluation work directories
**/.pytest-temp-*/
**/.pytest_tmp_*/

# Local agent scratch work, including task specs and test evidence
/.scratch/

# Local wiki import staging area (source files are maintained in the wiki)
/.wiki-ingest/

# Local documentation and runtime logs
/docs/
/logs/

# Root-level local Markdown notes (subdirectories remain unaffected)
/*.md
!/README.md
/AGENTS.md








